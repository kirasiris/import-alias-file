{
	"name": "import-alias-file",
	"version": "2.0.1",
	"description": "Import files via @ alias without having to manually enter ../ several times",
	"private": false,
	"main": "build/index.js",
	"module": "build/index.js",
	"type": "commonjs",
	"types": "build/index.d.ts",
	"exports": {
		"require": "./build/cjs/index.js",
		"import": "./build/esm/index.js"
	},
	"files": [
		"build",
		"README.md"
	],
	"scripts": {
		"test": "jest",
		"build": "rimraf build && npx tsc -p tsconfig.esm.json && npx tsc -p tsconfig.cjs.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kirasiris/import-alias-file.git"
	},
	"keywords": [
		"nextjs",
		"alias",
		"files",
		"filesystem",
		"file-system",
		"import",
		"files-import",
		"nodejs"
	],
	"author": "Kevin Uriel Fonseca",
	"license": "GPL-2.0-only",
	"bugs": {
		"email": "kebin1421@hotmail.com",
		"url": "https://github.com/kirasiris/import-alias-file/issues"
	},
	"homepage": "https://github.com/kirasiris/import-alias-file#readme",
	"dependencies": {
		"node": "^27.0.0-alpha.0.0.0"
	},
	"devDependencies": {
		"@babel/plugin-transform-runtime": "^8.0.6",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-typescript": "^8.0.7",
		"@types/jest": "^30.0.0",
		"babel-jest": "^30.5.2",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.15",
		"typescript": "^6.0.3"
	}
}
